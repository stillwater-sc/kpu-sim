csp 1.0
// generated by kpu-csp-gen: linear C = gelu(A . B + b), col-panel schedule, epilogue unfused, 64 in 16x16 tiles, L3 128 (9 used at peak)
program linear machine flat(l3 = 128) {
  tensor A[64,64] tile 16x16 in;
  tensor B[64,64] tile 16x16 in;
  vector b[64] tile 16 in;
  tensor C[64,64] tile 16x16 inout;
  for j in 0..4 {
    resident B[:, j];
    for i in 0..4 {
      resident A[i, :];
      acc C[i, j] in fabric {
        for k in 0..4 { call gemm(A[i, k], B[k, j]) +-> C[i, j]; }
      }
      store C[i, j];
      release A[i, :];
    }
    release B[:, j];
  }
  for j in 0..4 {
    resident b[j];
    for i in 0..4 {
      resident C[i, j];
      call add(C[i, j], b[j]) -> C[i, j];
      call gelu(C[i, j]) -> C[i, j];
      store C[i, j];
      release C[i, j];
    }
    release b[j];
  }
}
