csp 1.0
// generated by kpu-csp-gen: matmul C = A . B + b, col-panel schedule, the accumulator's init streamed in, 16 in 4x4 tiles, L3 12 (10 used at peak)
program matmul machine flat(l3 = 12) {
  tensor A[16,16] int8 tile 4x4 in;
  tensor B[16,16] int8 tile 4x4 in;
  vector b[16] int32 tile 4 in;
  tensor C[16,16] int32 tile 4x4 out;
  for j in 0..4 {
    resident B[:, j], b[j];
    for i in 0..4 {
      resident A[i, :];
      acc C[i, j] in fabric init b[j] {
        for k in 0..4 { call gemm(A[i, k], B[k, j]) +-> C[i, j]; }
      }
      store C[i, j] late;
      release A[i, :];
    }
    release B[:, j], b[j];
  }
}
