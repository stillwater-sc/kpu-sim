csp 1.0
// generated by kpu-csp-gen: linear C = relu(A . B + b), col-panel schedule, epilogue @ fabric, 64 in 16x16 tiles, L3 128 (10 used at peak)
program linear machine flat(l3 = 128) {
  tensor A[64,64] tile 16x16 in;
  tensor B[64,64] tile 16x16 in;
  vector b[64] tile 16 in;
  tensor C[64,64] tile 16x16 out;
  for j in 0..4 {
    resident B[:, j], b[j];
    for i in 0..4 {
      resident A[i, :];
      acc C[i, j] in fabric {
        for k in 0..4 { call gemm(A[i, k], B[k, j]) +-> C[i, j]; }
      }
      store C[i, j] via add(b[j]) @ fabric, relu @ fabric;
      release A[i, :];
    }
    release B[:, j], b[j];
  }
}
