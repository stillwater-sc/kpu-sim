KPUL0 1.2.0
MIN_CONSUMER 1.0.0
OPSET tile 1.2.0
PRODUCER kpu-sim 0.8.0
PROGRAM "matmul"
VALUES none
OPERAND "A" rows=32 cols=32 tile_rows=16 tile_cols=16
OPERAND "B" rows=32 cols=32 tile_rows=16 tile_cols=16
OPERAND "C" rows=32 cols=32 tile_rows=16 tile_cols=16
OP kind=L3_LOAD out=B:0,0 l3=0 slot=0 bank=0
