OP kind=DRAIN out=C:1,0 port_kind=output port="South"
OP kind=L3_WRITEBACK out=C:1,0 l3=0 slot=7 bank=0
OP kind=L3_STORE out=C:1,0 l3=0 slot=7 bank=0
OP kind=L3_RELEASE out=C:1,0 l3=0 slot=7 bank=0
OP kind=L3_RELEASE out=A:1,0 l3=0 slot=5 bank=0
OP kind=L3_RELEASE out=A:1,1 l3=0 slot=6 bank=0
OP kind=L3_RELEASE out=B:0,0 l3=0 slot=0 bank=0
OP kind=L3_RELEASE out=B:1,0 l3=0 slot=1 bank=0
