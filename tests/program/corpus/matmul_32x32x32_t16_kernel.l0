KPUL0 1.2.0
MIN_CONSUMER 1.0.0
OPSET tile 1.0.0
PRODUCER kpu-sim 0.8.0
PROGRAM "matmul 32x32x32"
VALUES none
OPERAND "A" rows=32 cols=32 tile_rows=16 tile_cols=16
OPERAND "B" rows=32 cols=32 tile_rows=16 tile_cols=16
OPERAND "C" rows=32 cols=32 tile_rows=16 tile_cols=16
OP kind=FEED in=A:0,0 port_kind=input port="West"
OP kind=FEED in=B:0,0 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:0,0;B:0,0 out=C:0,0
OP kind=FEED in=A:0,1 port_kind=input port="West"
OP kind=FEED in=B:1,0 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:0,1;B:1,0 out=C:0,0
OP kind=DRAIN out=C:0,0 port_kind=output port="South"
OP kind=FEED in=A:0,0 port_kind=input port="West"
OP kind=FEED in=B:0,1 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:0,0;B:0,1 out=C:0,1
OP kind=FEED in=A:0,1 port_kind=input port="West"
OP kind=FEED in=B:1,1 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:0,1;B:1,1 out=C:0,1
OP kind=DRAIN out=C:0,1 port_kind=output port="South"
OP kind=FEED in=A:1,0 port_kind=input port="West"
OP kind=FEED in=B:0,0 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:1,0;B:0,0 out=C:1,0
OP kind=FEED in=A:1,1 port_kind=input port="West"
OP kind=FEED in=B:1,0 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:1,1;B:1,0 out=C:1,0
OP kind=DRAIN out=C:1,0 port_kind=output port="South"
OP kind=FEED in=A:1,0 port_kind=input port="West"
OP kind=FEED in=B:0,1 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:1,0;B:0,1 out=C:1,1
OP kind=FEED in=A:1,1 port_kind=input port="West"
OP kind=FEED in=B:1,1 port_kind=input port="North"
OP kind=MATMUL_ACCUM in=A:1,1;B:1,1 out=C:1,1
OP kind=DRAIN out=C:1,1 port_kind=output port="South"
END
