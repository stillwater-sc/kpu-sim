csp 1.0
// generated by kpu-csp-gen: matmul C = A . B, col-panel schedule, 48 in 16x16 tiles, L3 128 (7 used at peak)
program matmul machine flat(l3 = 128) {
  tensor A[48,48] tile 16x16 in;
  tensor B[48,48] tile 16x16 in;
  tensor C[48,48] tile 16x16 out;
  for j in 0..3 {
    resident B[:, j];
    for i in 0..3 {
      resident A[i, :];
      acc C[i, j] in fabric {
        for k in 0..3 { call gemm(A[i, k], B[k, j]) +-> C[i, j]; }
      }
      store C[i, j];
      release A[i, :];
    }
    release B[:, j];
  }
}
