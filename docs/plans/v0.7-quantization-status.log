  │ CREDIT_STALL_L3     │ L0     │ -          │ count, stall_cycles            │
  │ CREDIT_STALL_L2     │ L0     │ -          │ count, stall_cycles            │
  │ CREDIT_STALL_L1     │ L0     │ -          │ count, stall_cycles            │
  │ CREDIT_UPDATE       │ L1     │ Σ UPDATE_Lx│ count                          │
  │ CREDIT_STALL        │ L1     │ Σ STALL_Lx │ count, total_stall_cycles      │
  │ CREDIT_FLOW         │ L2     │ UPDATE +   │ count, stall_cycles            │
  │                     │        │ STALL      │                                │
  │ BARRIER_ENTER       │ L0     │ -          │ count, barrier_id              │
  │ BARRIER_EXIT        │ L0     │ -          │ count, wait_cycles             │
  │ BARRIER_WAIT        │ L1     │ ENTER+EXIT │ count, total_wait_cycles       │
  │ DEP_WAIT            │ L0     │ -          │ count, wait_cycles             │
  │ DEP_SIGNAL          │ L0     │ -          │ count                          │
  │ DEPENDENCY          │ L1     │ WAIT+SIGNAL│ count, total_wait_cycles       │
  │ SYNC_TOTAL          │ L2     │ CREDIT +   │ count, total_stall_cycles      │
  │                     │        │ BARRIER +  │                                │
  │                     │        │ DEP        │                                │
  └─────────────────────┴────────┴────────────┴────────────────────────────────┘

  SYNC XUE METRICS (Operational Analysis):
    avg_latency_L3 = CREDIT_STALL_L3.stall_cycles / CREDIT_STALL_L3.count
    avg_latency_L2 = CREDIT_STALL_L2.stall_cycles / CREDIT_STALL_L2.count
    avg_latency_L1 = CREDIT_STALL_L1.stall_cycles / CREDIT_STALL_L1.count

    sync_overhead = SYNC_TOTAL.stall_cycles / total_cycles    [0.0 - 1.0]
    credit_update_rate = CREDIT_UPDATE.count / total_cycles   [updates/cycle]

