  │ RELU                │ L2     │ N × (CMP + MAX)     │ count, elements,      │
  │                     │        │                     │ total_cmps,           │
  │                     │        │                     │ total_maxs, cycles    │
  ├─────────────────────┼────────┼─────────────────────┼───────────────────────┤
  │ GELU                │ L2     │ N × (MUL + ADD +    │ count, elements,      │
  │                     │        │      TANH + MUL +   │ total_muls,           │
  │                     │        │      ADD + MUL)     │ total_adds,           │
  │                     │        │ ≈ 3 MUL, 2 ADD,     │ total_tanhs, cycles   │
  │                     │        │   1 TANH per elem   │                       │
  ├─────────────────────┼────────┼─────────────────────┼───────────────────────┤
  │ SILU                │ L2     │ N × (EXP + ADD +    │ count, elements,      │
  │                     │        │      DIV + MUL)     │ total_exps,           │
  │                     │        │ = sigmoid × x       │ total_divs,           │
  │                     │        │                     │ total_muls, cycles    │
  ├─────────────────────┼────────┼─────────────────────┼───────────────────────┤
  │ SOFTMAX             │ L2     │ N × (EXP + ADD) +   │ count, elements,      │
  │                     │        │ reduction + N×DIV   │ total_exps,           │
  │                     │        │                     │ total_divs, cycles    │
  ├─────────────────────┼────────┼─────────────────────┼───────────────────────┤
  │ LAYERNORM           │ L2     │ mean: N×ADD + DIV   │ count, elements,      │
  │                     │        │ var:  N×(SUB+MUL+   │ total_muls,           │
  │                     │        │       ADD) + DIV    │ total_adds,           │
  │                     │        │ norm: N×(SUB+MUL+   │ total_sqrts, cycles   │
  │                     │        │       SQRT+DIV+     │                       │
  │                     │        │       MUL+ADD)      │                       │
  ├─────────────────────┼────────┼─────────────────────┼───────────────────────┤
  │ MLP_LAYER           │ L3     │ MATMUL + BIAS +     │ count, total_macs,    │
  │                     │        │ ACTIVATION          │ total_alu_ops, cycles │
  ├─────────────────────┼────────┼─────────────────────┼───────────────────────┤
  │ MLP_INFERENCE       │ L4     │ Σ MLP_LAYER         │ count, total_macs,    │
  │                     │        │                     │ total_alu_ops,        │
  │                     │        │                     │ total_cycles          │
  └─────────────────────┴────────┴─────────────────────┴───────────────────────┘

  COMPUTE XUE METRICS:
    X_mac    = total_macs / total_cycles                      [MACs/cycle]
    X_alu    = total_alu_ops / total_cycles                   [ops/cycle]
    X_flops  = (2×total_macs + total_other_alu) / total_cycles [FLOPS/cycle]
    U_systolic = systolic_busy_cycles / total_cycles          [0.0 - 1.0]
    E_systolic = achieved_macs / (peak_macs × U_systolic)     [0.0 - 1.0]

