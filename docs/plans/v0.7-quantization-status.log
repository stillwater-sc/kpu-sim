  L1 XUE METRICS:
    X_l1_vec  = L1_VECTOR_TXN.vectors / total_cycles          [vectors/cycle]
    X_l1_elem = L1_ELEMENT_TXN.elements / total_cycles        [elements/cycle]
    X_l1_byte = L1_TOTAL.bytes / total_cycles                 [bytes/cycle]
    U_l1      = L1_busy_cycles / total_cycles                 [0.0 - 1.0]
    E_l1      = X_l1_byte / L1_port_bandwidth                 [0.0 - 1.0]

