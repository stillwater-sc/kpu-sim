csp 1.1
// examples/program/matmul_48_stage_a.csp: generated by `kpu-csp-gen --algo matmul --size 48 --tile 16 --l3 32 --stage-a`
// matmul C = A . B, row-panel schedule, A's row panel staged in L2, 48 in 16x16 tiles, L3 32 (7 used at peak)
program matmul machine flat(l3 = 32, l2 = 9) {
  tensor A[48,48] tile 16x16 in;
  tensor B[48,48] tile 16x16 in;
  tensor C[48,48] tile 16x16 out;
  for i in 0..3 {
    resident A[i, :];
    stage A[i, :] in l2 {
      for j in 0..3 {
        resident B[:, j];
        acc C[i, j] in fabric {
          for k in 0..3 { call gemm(A[i, k], B[k, j]) +-> C[i, j]; }
        }
        store C[i, j] late;
        release B[:, j];
      }
    }
    release A[i, :];
  }
}
