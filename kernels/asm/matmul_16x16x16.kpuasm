; matmul_16x16x16.kpuasm
; Matrix multiplication: C[16,16] = A[16,16] x B[16,16]
; Single-tile output-stationary schedule
;
; Memory layout:
;   A[16,16]: 16*16*4 = 1024 bytes at 0x0000
;   B[16,16]: 16*16*4 = 1024 bytes at 0x0400
;   C[16,16]: 16*16*4 = 1024 bytes at 0x0800

.name "matmul_16x16x16"
.version 1
.dimensions M=16, N=16, K=16
.tiling Ti=16, Tj=16, Tk=16
.l1_ki 16
.dataflow output_stationary

.a_base 0x0000
.b_base 0x0400
.c_base 0x0800

; ============================================================
; Load A and B tiles from external memory to L3
; Note: Addresses are OFFSETS within the matrix, not absolute.
; The executor adds the matrix base address.
; ============================================================
load_tiles:
    DMA_LOAD_TILE A, (0,0,0), 0, 0, 0, 1024, BUF_0
    DMA_LOAD_TILE B, (0,0,0), 0, 1, 0, 1024, BUF_0
    BARRIER

; ============================================================
; Move tiles from L3 to L2
; ============================================================
move_to_l2:
    BM_MOVE_TILE A, (0,0,0), 0, 0, 0, 0, 16, 16, 4, BUF_0
    BM_MOVE_TILE B, (0,0,0), 1, 0, 1, 0, 16, 16, 4, BUF_0
    BARRIER

; ============================================================
; Stream tiles to systolic array
; A rows feed from west, B columns feed from north
; ============================================================
stream_compute:
    STR_FEED_ROWS A, (0,0,0), 0, 0, 0, 0, 16, 16, 16, BUF_0
    STR_FEED_COLS B, (0,0,0), 1, 0, 0, 0, 16, 16, 16, BUF_0
    ; Compute happens reactively in PE accumulators
    BARRIER

; ============================================================
; Drain C from systolic array to L2, then L3, then external memory
; ============================================================
drain_output:
    STR_DRAIN_OUTPUT (0,0,0), 2, 0, 0, 0, 16, 16, 16, BUF_0
    BARRIER
    BM_WRITEBACK_TILE C, (0,0,0), 2, 0, 2, 0, 16, 16, 4, BUF_0
    BARRIER
    DMA_STORE_TILE C, (0,0,0), 0, 2, 0, 1024, BUF_0
    BARRIER

HALT
